# URL base del API (se usa cuando el host no envía `apiBaseUrl`).
# Relativa (/account-api/...) usa el proxy de Vite en dev; absoluta llama directo al backend (requiere CORS).
VITE_ACCOUNT_API_URL=/account-api/public/api

# Rutas de los servicios, relativas a VITE_ACCOUNT_API_URL.
VITE_ACCOUNT_STATUS_PATH=account/status
VITE_ACCOUNT_TERCERO_PATH=account/tercero

# Solo dev: backend al que el proxy reenvía VITE_ACCOUNT_API_URL cuando es relativa.
VITE_API_PROXY_TARGET=http://localhost:8081
